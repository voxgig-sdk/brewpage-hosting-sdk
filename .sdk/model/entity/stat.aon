# Entity: stat

main: kit: entity: stat: {

  alias: field: {}

  fields: [
    {
      name: "totalResources"
      req: false
      short: "Total number of resources hosted on the platform"
      type: "`$INTEGER`"
    }
    {
      name: "totalViews"
      req: false
      short: "Total number of views across all resources"
      type: "`$INTEGER`"
    }
    {
      name: "viewsToday"
      req: false
      short: "Number of views recorded today"
      type: "`$INTEGER`"
    }
  ]

  name: "stat"
  op: {
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "GET /stats"
            json: "{\"operationId\":\"getStats\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"totalResources\":{\"description\":\"Total number of resources hosted on the platform\",\"example\":5000,\"type\":\"integer\"},\"totalViews\":{\"description\":\"Total number of views across all resources\",\"example\":1000000,\"type\":\"integer\"},\"viewsToday\":{\"description\":\"Number of views recorded today\",\"example\":1500,\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful response with platform statistics\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"example\":\"Internal server error\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/stats"
          segments: [
            {
              lit: "stats"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
