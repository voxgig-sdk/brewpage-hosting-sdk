# Entity: stat

main: kit: entity: stat: {

  alias: field: {}

  fields: [
    {
      name: "totalResources"
      req: false
      short: "Total number of resources hosted on the platform"
      type: "`$INTEGER`"
    }
    {
      name: "totalViews"
      req: false
      short: "Total number of views across all resources"
      type: "`$INTEGER`"
    }
    {
      name: "viewsToday"
      req: false
      short: "Number of views recorded today"
      type: "`$INTEGER`"
    }
  ]

  name: "stat"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/stats"
          parts: [
            "stats"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
